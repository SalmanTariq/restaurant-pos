# Server-only Backblaze B2 settings for MySQL backups.
# Install on the POS host (never commit real keys):
#   sudo install -m 600 config/restaurant-pos-backup.env.example /etc/restaurant-pos-backup.env
#   sudo nano /etc/restaurant-pos-backup.env
#
# Create an Application Key in the Backblaze console limited to this bucket.
# You need BOTH values: keyID and applicationKey.

# Backblaze key ID (looks like 00… or similar)
B2_KEY_ID=

# Backblaze application key (secret — paste once, chmod 600 this file)
B2_APPLICATION_KEY=

# Bucket name (default is fine)
B2_BUCKET=restaurant-pos-st

# Folder prefix inside the bucket
B2_PREFIX=mysql

# How many days of local dumps to keep on disk
KEEP_DAYS=14

# Optional alternatives (leave blank to use B2_* above):
# RCLONE_REMOTE=b2:restaurant-pos-st/mysql
# RSYNC_TARGET=backup@otherhost:/backups/pos
